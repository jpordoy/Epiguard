<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#FF6200EE" />  <!-- Example: purple -->

    <!-- Border/stroke -->
    <stroke
        android:width="2dp"
        android:color="#FF3700B3" />  <!-- Darker purple border -->

    <!-- Corners rounded -->
    <corners android:radius="12dp" />

    <!-- Padding (optional) -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
